{
  "name": "@elevate/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema (core + module schema files), client factory (node-postgres or PGlite), migration and seed runners, and createTestDb() for tests.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./src/seed/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@elevate/configuration": "0.1.0",
    "@elevate/shared-types": "0.1.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
