{
  "business-ops-os release": {
    "basePath": "/ops",
    "env": {
      "ELEVATE_BASE_PATH": "/ops"
    },
    "output": "standalone",
    "reactStrictMode": true,
    "poweredByHeader": false,
    "turbopack": {
      "root": "<repo>"
    },
    "outputFileTracingRoot": "<repo>",
    "transpilePackages": [
      "@elevate/authentication",
      "@elevate/authorization",
      "@elevate/configuration",
      "@elevate/database",
      "@elevate/notifications",
      "@elevate/server-kit",
      "@elevate/shared-contracts",
      "@elevate/shared-types",
      "@elevate/shared-ui"
    ],
    "serverExternalPackages": ["@electric-sql/pglite", "pg"],
    "experimental": {
      "serverActions": {
        "allowedOrigins": ["platform.test:4003"]
      }
    },
    "headers": [
      {
        "source": "/:path*",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/ops",
        "basePath": false,
        "permanent": false
      }
    ]
  },
