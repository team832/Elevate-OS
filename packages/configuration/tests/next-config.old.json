      "@elevate/shared-contracts",
      "@elevate/shared-types",
      "@elevate/shared-ui"
    ],
    "serverExternalPackages": ["@electric-sql/pglite", "pg"],
    "headers": [
      {
        "source": "/((?!marketing(?:/|$)|academic(?:/|$)|ops(?:/|$)).*)",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/:zone(marketing|academic|ops)/api/internal/:rest*",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/marketing",
        "destination": "http://marketing.test:4002/marketing"
      },
      {
        "source": "/marketing/:path((?!api/internal(?:/|$)).+)",
        "destination": "http://marketing.test:4002/marketing/:path"
      },
      {
        "source": "/academic",
        "destination": "http://academic.test:4001/academic"
      },
      {
        "source": "/academic/:path((?!api/internal(?:/|$)).+)",
        "destination": "http://academic.test:4001/academic/:path"
      },
      {
        "source": "/ops",
        "destination": "http://ops.test:4000/ops"
      },
      {
        "source": "/ops/:path((?!api/internal(?:/|$)).+)",
        "destination": "http://ops.test:4000/ops/:path"
      }
    ]
  },
