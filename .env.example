# Elevate OS — environment variables
#
# Copy this file to `.env` in the repository root and replace every placeholder.
# `.env` is git-ignored; never commit real values. All four Next.js apps and every
# script (db:migrate, db:seed, db:reset, db:start) read the ROOT `.env`.
# Values already present in the process environment win over the file.

# --- Database -------------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/DBNAME  -> real PostgreSQL via node-postgres
# pglite://memory                             -> in-process PGlite, data lost on exit (single process only)
# pglite://.data/pglite                       -> in-process PGlite persisted to a directory (single process only)
# `npm run db:start` runs a local PostgreSQL server (embedded-postgres) using the user,
# password, port and database name parsed from this URL. Host must be 127.0.0.1/localhost.
DATABASE_URL=postgres://elevate:replace-with-a-local-dev-password@127.0.0.1:54320/elevate

# --- Authentication --------------------------------------------------------------
# Secret used to HMAC session tokens before they are stored (the DB never holds a raw token).
# At least 32 characters. Changing it signs everyone out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Shared bearer token for server-to-server calls to /<zone>/api/internal/* routes.
# At least 32 characters. Must be identical in all four apps.
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Optional: one token per module instead of the shared one, so a module cannot claim another
# module's identity on internal routes (the caller is the module whose token matched).
# Comma-separated <module>:<token> pairs (ops, academic, marketing, platform; 32+ characters
# each); the same value in all four apps. Leave empty to keep using INTERNAL_SERVICE_TOKEN alone.
INTERNAL_SERVICE_TOKENS=

# "Sign in with Google" (optional, D-030). Leave both empty and the Google button is not
# shown. To turn it on, follow docs/GOOGLE_SIGN_IN_SETUP.md and paste the two values from
# the Google Cloud console here. Google sends people back to PLATFORM_URL + /api/v1/auth/google/callback,
# so that exact address must be listed as an authorised redirect URI there.
# Server-only: never put these in a NEXT_PUBLIC_ variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First administrator at go-live (optional). Comma-separated @elevateeducation.in emails.
# Whoever is listed gets the platform_admin and director roles each time they sign in
# (password or Google), so they can open Users & roles and give everyone else access.
# Any other address (another domain, @example.test, a typo) is refused and sign-in stops
# working until it is fixed. Remove an email once another administrator exists if you want
# that person's roles to be changeable from the screen.
BOOTSTRAP_OWNER_EMAILS=

# --- Workspace locations (D-004, D-072) ----------------------------------------------
# Each workspace runs on its own origin; the port is taken from these URLs by
# `npm run dev:business | dev:academic | dev:marketing | dev:platform | dev:all`.
# They are also the allowlist for post-sign-in redirects and for cross-origin form posts.
BUSINESS_OPS_OS_URL=http://localhost:3000
ACADEMIC_OS_URL=http://localhost:3001
MARKETING_OS_URL=http://localhost:3002
# Platform app: Users & roles, Google sign-in callback, optional single-origin gateway.
PLATFORM_URL=http://localhost:3003

# --- Seeding (development only) ----------------------------------------------------
# Password given to every fictional seed user (one per role, @example.test emails).
# At least 12 characters. `npm run db:seed` refuses to run without it.
SEED_USER_PASSWORD=replace-with-a-dev-only-password

# One shared password for the three local demo sign-ins (business@, teacher@,
# marketing@elevateeducation.in) and satish@elevateeducation.in (a labelled development
# assumption linked to Satish's staff record), set by `npm run db:seed-demo-accounts`. At least 12
# characters. Never printed or sent to the browser; the script refuses production and any
# non-local DATABASE_URL, and `npm run db:clear-samples` switches the accounts off.
LOCAL_DEMO_PASSWORD=replace-with-a-dev-only-password

# --- External adapters (D-014: default is a mock that never claims a real connection) ---
# Allowed values: mock | disabled. Live adapters do not exist yet.
MARKETING_PUBLISHING_ADAPTER=mock
MARKETING_METRICS_ADAPTER=mock
NOTIFICATIONS_EMAIL_ADAPTER=mock

# --- Attachments (HR tasks, submissions, attendance corrections, feedback imports) ---
# Folder for uploaded files in development; empty = .data/attachments (git-ignored).
# ATTACHMENTS_DIR=

# --- AI drafting (OpenAI; drafts only — a person always checks and saves) ----------
# Without OPENAI_API_KEY and OPENAI_MODEL the AI buttons show "AI drafting is not set up".
# Secret API key from platform.openai.com; put the real value only in the git-ignored .env.
# OPENAI_API_KEY=
# Model name to use (no default in code), as listed in your OpenAI account.
# OPENAI_MODEL=
# Optional: give up after this many milliseconds (default 20000).
# OPENAI_TIMEOUT_MS=
# Optional: API address (default https://api.openai.com/v1).
# OPENAI_BASE_URL=

# --- Logging -------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
