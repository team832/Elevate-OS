# Elevate OS — environment variables
#
# Copy this file to `.env` in the repository root and replace every placeholder.
# `.env` is git-ignored; never commit real values. All four Next.js apps and every
# script (db:migrate, db:seed, db:reset, db:start) read the ROOT `.env`.
# Values already present in the process environment win over the file.

# --- Database -------------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/DBNAME  -> real PostgreSQL via node-postgres
# pglite://memory                             -> in-process PGlite, data lost on exit (single process only)
# pglite://.data/pglite                       -> in-process PGlite persisted to a directory (single process only)
# `npm run db:start` runs a local PostgreSQL server (embedded-postgres) using the user,
# password, port and database name parsed from this URL. Host must be 127.0.0.1/localhost.
DATABASE_URL=postgres://elevate:replace-with-a-local-dev-password@127.0.0.1:54320/elevate

# --- Authentication --------------------------------------------------------------
# Secret used to HMAC session tokens before they are stored (the DB never holds a raw token).
# At least 32 characters. Changing it signs everyone out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Shared bearer token for server-to-server calls to /<zone>/api/internal/* routes.
# At least 32 characters. Must be identical in all four apps.
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# --- Module app locations (used by the platform app's rewrites, D-004) -------------
# Rewrites are resolved when the platform app is built/started.
MARKETING_OS_URL=http://localhost:3001
ACADEMIC_OS_URL=http://localhost:3002
BUSINESS_OPS_OS_URL=http://localhost:3003

# --- Seeding (development only) ----------------------------------------------------
# Password given to every fictional seed user (one per role, @example.test emails).
# At least 12 characters. `npm run db:seed` refuses to run without it.
SEED_USER_PASSWORD=replace-with-a-dev-only-password

# --- External adapters (D-014: default is a mock that never claims a real connection) ---
# Allowed values: mock | disabled. Live adapters do not exist yet.
MARKETING_PUBLISHING_ADAPTER=mock
MARKETING_METRICS_ADAPTER=mock
NOTIFICATIONS_EMAIL_ADAPTER=mock

# --- Logging -------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
