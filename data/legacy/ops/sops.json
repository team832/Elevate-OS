      "id": "SOP-ONLINE-COORDINATOR",
      "title": "Online Class Coordinator SOP",
      "subtitle": "Staff responsibilities and daily workflow",
      "organisation": "Elevate Education",
      "dated": "2026-09-18",
      "owner": null,
      "backup": null,
      "reporting_manager": null,
      "effective_date": null,
      "approved_by": null,
      "approval_date": null,
      "blank_fields_in_source": [
        "Assigned staff",
        "Backup",
        "Reporting manager",
        "Effective date",
        "Manager approval",
        "Date",
